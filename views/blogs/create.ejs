<html lang="en">

 <%# Include the shared head partial as HTML. %>
 <%- include("../partials/head.ejs") %>

<body>
  
  <%# Include the shared navigation partial as HTML. %>
  <%- include("../partials/nav.ejs") %>

  <div class="create-blog content">
    <form action="/blogs" method="POST">
      <label for="title" name="title">Blog title:</label>
      <input type="text" id="title" name="title" required>
      <label for="snippet" name="snippet">Blog snippet:</label>
      <input type="text" id="snippet" name="snippet" required>
      <label for="body" name="body">Blog body:</label>
      <textarea id="body" name="body" required></textarea>
      <button>Submit</button>
    </form>
  </div>

  <%# Include the shared footer partial as HTML. %>
  <%- include("../partials/footer.ejs") %>

</body>

</html>