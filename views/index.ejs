<html lang="en">

  <%# Include the shared head partial as HTML. %>
  <%- include("./partials/head.ejs") %>

<body>

  <%# Include the shared navigation partial as HTML. %>
  <%- include("./partials/nav.ejs") %>

  <div class="blogs content">
    <h2>All Blogs</h2>
    <%# If blogs are available, loop through them and create a heading and paragraph for each blog. %>
    <% if (blogs.length > 0) { %>
      <% blogs.forEach(blog => { %>
        <h3 class="title"><%= blog.title %></h3>
        <p class="snippet"><%= blog.snippet %></p>
      <% }) %>
    <% } else { %>
      <%# Show a fallback message when the blogs array is empty. %>
      <p>There are no blogs to display.</p>
    <% } %>
  </div>

  <%# Include the shared footer partial as HTML. %>
  <%- include("./partials/footer.ejs") %>

</body>

</html>