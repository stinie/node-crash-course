<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📁</text></svg>">
  <title>Node.js Crash Course | <%= title %></title>
</head>

<body>
  <nav>
    <div class="site-title">
      <a href="/">
        <h1>Christine’s Code Journal</h1>
      </a>
      <p>Small steps, growing understanding. 🐢</p>
    </div>
    <ul>
      <li><a href="/">Blogs</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/blogs/create">New Blog</a></li>
    </ul>
  </nav>
  <div class="blogs content">
    <h2>All Blogs</h2>
    <%# If blogs are available, loop through them and create a heading and paragraph for each blog. %>
    <% if (blogs.length > 0) { %>
      <% blogs.forEach(blog => { %>
        <h3 class="title"><%= blog.title %></h3>
        <p class="snippet"><%= blog.snippet %></p>
      <% }) %>
    <% } else { %>
      <%# Show a fallback message when the blogs array is empty. %>
      <p>There are no blogs to display.</p>
    <% } %>
  </div>
</body>

</html>